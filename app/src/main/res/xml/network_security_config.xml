<?xml version="1.0" encoding="utf-8"?>
<!--
  Сервер пока работает по обычному HTTP (сертификата и домена нет),
  поэтому cleartext разрешён. Когда появится HTTPS — уберите этот файл
  и атрибут networkSecurityConfig из манифеста.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
