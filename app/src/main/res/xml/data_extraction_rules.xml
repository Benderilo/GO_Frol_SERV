<?xml version="1.0" encoding="utf-8"?>
<!--
  То же правило для Android 12+: настройки подключения и токен
  не уезжают ни в облако, ни при переносе на другое устройство.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/frolov_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/frolov_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
