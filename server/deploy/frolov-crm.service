[Unit]
Description=Frolov Systems CRM (сайт + API)
Documentation=https://github.com/Benderilo/GO_Frol_SERV
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frolov
Group=frolov
WorkingDirectory=/opt/frolov-crm
EnvironmentFile=/etc/frolov-crm.env
ExecStart=/opt/frolov-crm/frolov-crm
Restart=always
RestartSec=3

# Разрешаем непривилегированному процессу слушать 80/443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Изоляция: сервису нужен только свой каталог с базой.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/opt/frolov-crm/data

# 955 МБ RAM на весь сервер — держим сервис в разумных рамках.
MemoryMax=320M
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=frolov-crm

[Install]
WantedBy=multi-user.target
